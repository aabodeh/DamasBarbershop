@page "/BookNow"
@model DamasBarbershop.Pages.BookNowModel
@{
    ViewData["Title"] = "Book Now";
}

<section class="page-banner">
    <div class="container">
        <div class="eyebrow">Appointments</div>
        <h1>Book Now</h1>
        <p>Pick a service, a barber, and a time — we'll confirm your spot.</p>
    </div>
</section>

<section>
    <div class="container">
        <div class="booking-wrap">

            @if (Model.Success)
            {
                <div class="booking-success">
                    <div class="dot">✓</div>
                    <h2>Request Received</h2>
                    <p>Thanks — we'll confirm your appointment shortly by phone or email.</p>
                    <a class="btn btn-gold" href="/BookNow">Book Another</a>
                </div>
            }
            else
            {
                @if (!ModelState.IsValid)
                {
                    <div class="notice notice-error">Something was missing from your request — please try again.</div>
                }

                <div class="steps-bar">
                    <div class="step-dot active" data-step-indicator="1"><div class="dot">1</div>Service</div>
                    <div class="step-dot" data-step-indicator="2"><div class="dot">2</div>Barber</div>
                    <div class="step-dot" data-step-indicator="3"><div class="dot">3</div>Date & Time</div>
                    <div class="step-dot" data-step-indicator="4"><div class="dot">4</div>Confirm</div>
                </div>

                <form method="post" id="damas-booking-form">
                    <input type="hidden" asp-for="Booking.Service" id="field-service">
                    <input type="hidden" asp-for="Booking.Barber" id="field-barber">
                    <input type="hidden" asp-for="Booking.Date" id="field-date">
                    <input type="hidden" asp-for="Booking.Time" id="field-time">

                    <div class="booking-step active" data-step="1">
                        <h3 style="margin-bottom:20px;">Choose a Service</h3>
                        <div class="option-grid">
                            @foreach (var s in Model.Services)
                            {
                                <div class="option-card" data-select-service="@s.Name">
                                    <h4>@s.Name</h4>
                                    <div class="opt-meta">@s.Price · @s.Time</div>
                                </div>
                            }
                        </div>
                        <div class="step-actions">
                            <span></span>
                            <button type="button" class="btn btn-gold" data-next disabled>Continue</button>
                        </div>
                    </div>

                    <div class="booking-step" data-step="2">
                        <h3 style="margin-bottom:20px;">Choose a Barber</h3>
                        <div class="option-grid">
                            @foreach (var b in Model.Barbers)
                            {
                                <div class="option-card" data-select-barber="@b.Name">
                                    <h4>@b.Name</h4>
                                    <div class="opt-meta">@b.Role</div>
                                </div>
                            }
                        </div>
                        <div class="step-actions">
                            <button type="button" class="link-btn" data-prev>&larr; Back</button>
                            <button type="button" class="btn btn-gold" data-next disabled>Continue</button>
                        </div>
                    </div>

                    <div class="booking-step" data-step="3">
                        <h3 style="margin-bottom:20px;">Choose Date & Time</h3>
                        <div class="form-row">
                            <label for="date-input">Date</label>
                            <input type="date" id="date-input">
                        </div>
                        <div class="time-grid" id="time-grid">
                            @foreach (var t in Model.Times)
                            {
                                <div class="time-slot" data-select-time="@t">@t</div>
                            }
                        </div>
                        <div class="step-actions">
                            <button type="button" class="link-btn" data-prev>&larr; Back</button>
                            <button type="button" class="btn btn-gold" data-next disabled>Continue</button>
                        </div>
                    </div>

                    <div class="booking-step" data-step="4">
                        <h3 style="margin-bottom:20px;">Your Details</h3>
                        <div class="summary-box" id="summary-box"></div>
                        <div class="form-grid-2">
                            <div class="form-row">
                                <label for="name">Full Name</label>
                                <input type="text" id="name" asp-for="Booking.Name" required>
                            </div>
                            <div class="form-row">
                                <label for="phone">Phone</label>
                                <input type="tel" id="phone" asp-for="Booking.Phone" required>
                            </div>
                        </div>
                        <div class="form-row">
                            <label for="email">Email</label>
                            <input type="email" id="email" asp-for="Booking.Email">
                        </div>
                        <div class="form-row">
                            <label for="notes">Notes (optional)</label>
                            <textarea id="notes" asp-for="Booking.Notes" placeholder="Anything your barber should know?"></textarea>
                        </div>
                        <div class="step-actions">
                            <button type="button" class="link-btn" data-prev>&larr; Back</button>
                            <button type="submit" class="btn btn-gold">Confirm Booking</button>
                        </div>
                    </div>
                </form>
            }
        </div>
    </div>
</section>
