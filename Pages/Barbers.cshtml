@page "/Barbers"
@{
    ViewData["Title"] = "Barbers";
    var barbers = new[] {
        ("Barber Name", "Owner / Master Barber", "Over a decade behind the chair, specializing in classic cuts and straight-razor shaves."),
        ("Barber Name", "Senior Barber", "Known for sharp skin fades and beard sculpting."),
        ("Barber Name", "Barber", "Modern styles with an old-school finish."),
        ("Barber Name", "Barber", "Precision fades and kids cuts, always on time.")
    };
}

<section class="page-banner">
    <div class="container">
        <div class="eyebrow">The Team</div>
        <h1>Our Barbers</h1>
        <p>Replace these placeholders with your team's names, photos and specialties.</p>
    </div>
</section>

<section>
    <div class="container">
        <div class="grid-4">
            @foreach (var (name, role, bio) in barbers)
            {
                <div class="barber-card">
                    <div class="barber-photo">barber photo</div>
                    <div class="barber-info">
                        <h3>@name</h3>
                        <div class="barber-role">@role</div>
                        <p class="barber-bio">@bio</p>
                        <div class="barber-social"><a href="#">Instagram</a></div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="cta-banner">
    <div class="container">
        <h2>Book With Your Favorite Barber</h2>
        <a class="btn btn-dark" href="/BookNow">Book Now</a>
    </div>
</section>
