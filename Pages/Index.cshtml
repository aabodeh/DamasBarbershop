@page "/"
@{
    ViewData["Title"] = "Home";
}

<section class="hero" style="background-image:url('/img/shop-interior.jpg');">
    <div class="hero-content">
        <div class="eyebrow">Est. Your City</div>
        <h1>Damas</h1>
        <p>Old-world barbering — sharp fades, hot towel shaves and straight-razor lineups, done right in a shop built for it.</p>
        <div class="hero-ctas">
            <a class="btn btn-gold" href="/BookNow">Book an Appointment</a>
            <a class="btn btn-outline" href="/Services">View Services</a>
        </div>
    </div>
</section>

<section>
    <div class="container">
        <div class="section-head">
            <div class="eyebrow">The Shop</div>
            <h2>Where Craft Meets Comfort</h2>
            <div class="divider"></div>
            <p>Dark wood, brass chairs and tan leather — a shop that feels like a barbershop, not a salon. Walk in, sit down, leave sharp.</p>
        </div>
    </div>
</section>

<section class="section-dark">
    <div class="container">
        <div class="section-head">
            <div class="eyebrow">Popular</div>
            <h2 style="color:var(--cream);">Services</h2>
            <div class="divider"></div>
        </div>
        <div class="grid-3">
            <div class="card service-card">
                <h3>Signature Haircut</h3>
                <div class="service-price">$35</div>
                <div class="service-meta">30 minutes</div>
                <p>A precision cut tailored to your face shape and style, finished with a hot towel.</p>
            </div>
            <div class="card service-card">
                <h3>Beard Trim & Shape</h3>
                <div class="service-price">$20</div>
                <div class="service-meta">15 minutes</div>
                <p>Clean lines and a sharp shape, straight-razor finished.</p>
            </div>
            <div class="card service-card">
                <h3>Hot Towel Shave</h3>
                <div class="service-price">$40</div>
                <div class="service-meta">45 minutes</div>
                <p>The full old-school experience — steam, lather, and a straight razor.</p>
            </div>
        </div>
        <div style="text-align:center;margin-top:44px;">
            <a class="btn btn-outline" href="/Services">See Full Menu & Pricing</a>
        </div>
    </div>
</section>

<section>
    <div class="container">
        <div class="section-head">
            <div class="eyebrow">Meet the Team</div>
            <h2>Your Barbers</h2>
            <div class="divider"></div>
        </div>
        <div class="grid-4">
            <div class="barber-card">
                <div class="barber-photo">barber photo</div>
                <div class="barber-info"><h3>Barber Name</h3><div class="barber-role">Owner / Master Barber</div></div>
            </div>
            <div class="barber-card">
                <div class="barber-photo">barber photo</div>
                <div class="barber-info"><h3>Barber Name</h3><div class="barber-role">Senior Barber</div></div>
            </div>
            <div class="barber-card">
                <div class="barber-photo">barber photo</div>
                <div class="barber-info"><h3>Barber Name</h3><div class="barber-role">Barber</div></div>
            </div>
            <div class="barber-card">
                <div class="barber-photo">barber photo</div>
                <div class="barber-info"><h3>Barber Name</h3><div class="barber-role">Barber</div></div>
            </div>
        </div>
        <div style="text-align:center;margin-top:44px;">
            <a class="btn btn-outline" style="color:var(--ink-text);border-color:var(--wood);" href="/Barbers">Meet the Full Team</a>
        </div>
    </div>
</section>

<section class="cta-banner">
    <div class="container">
        <h2>Ready for a Fresh Cut?</h2>
        <p style="margin-bottom:26px;">Pick your service, your barber, and a time that works.</p>
        <a class="btn btn-dark" href="/BookNow">Book Now</a>
    </div>
</section>
