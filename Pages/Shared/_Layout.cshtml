@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>@ViewData["Title"] - @Configuration["ShopInfo:Name"]</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/site.css">
</head>
<body>

@{
    var path = Context.Request.Path.Value ?? "/";
    string NavClass(string href) => (href == "/" ? path == "/" : path.StartsWith(href)) ? "current" : "";
}

<header class="site-header">
    <div class="header-inner">
        <a class="logo" href="/">DAMAS<span> BARBERSHOP</span></a>
        <button class="nav-toggle" aria-label="Menu" onclick="document.querySelector('.main-nav').classList.toggle('open')">&#9776;</button>
        <nav class="main-nav">
            <ul>
                <li><a class="@NavClass("/")" href="/">Home</a></li>
                <li><a class="@NavClass("/Services")" href="/Services">Services & Pricing</a></li>
                <li><a class="@NavClass("/Barbers")" href="/Barbers">Barbers</a></li>
                <li><a class="@NavClass("/Gallery")" href="/Gallery">Gallery</a></li>
                <li><a class="@NavClass("/BookNow")" href="/BookNow">Book Now</a></li>
            </ul>
        </nav>
        <div class="header-actions">
            <span class="header-phone">📞 @Configuration["ShopInfo:Phone"]</span>
            <a class="btn btn-gold" href="/BookNow">Book Now</a>
        </div>
    </div>
</header>

@RenderBody()

<footer class="site-footer">
    <div class="container">
        <div class="footer-grid">
            <div>
                <a class="logo" href="/">DAMAS<span> BARBERSHOP</span></a>
                <p style="margin-top:16px;max-width:320px;color:#c9bfab;font-size:14px;">Classic cuts, hot towel shaves and straight-razor lineups in a shop built the old way — dark wood, brass chairs, no shortcuts.</p>
                <div class="footer-social">
                    <a href="@Configuration["ShopInfo:Instagram"]" target="_blank" rel="noopener">IG</a>
                    <a href="@Configuration["ShopInfo:Facebook"]" target="_blank" rel="noopener">FB</a>
                </div>
            </div>
            <div>
                <h4>Quick Links</h4>
                <ul>
                    <li><a href="/Services">Services & Pricing</a></li>
                    <li><a href="/Barbers">Barbers</a></li>
                    <li><a href="/Gallery">Gallery</a></li>
                    <li><a href="/BookNow">Book Now</a></li>
                </ul>
            </div>
            <div>
                <h4>Visit Us</h4>
                <ul>
                    <li>@Configuration["ShopInfo:Address"]</li>
                    <li>@Configuration["ShopInfo:Hours"]</li>
                    <li>@Configuration["ShopInfo:Phone"]</li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">&copy; @DateTime.Now.Year @Configuration["ShopInfo:Name"]. All rights reserved.</div>
    </div>
</footer>

<script src="~/js/booking.js"></script>
</body>
</html>
