@page "/Gallery"
@{
    ViewData["Title"] = "Gallery";
}

<section class="page-banner">
    <div class="container">
        <div class="eyebrow">Inside the Shop</div>
        <h1>Gallery</h1>
        <p>Replace these placeholders with real photos of your shop, cuts and team.</p>
    </div>
</section>

<section>
    <div class="container">
        <div class="gallery-grid">
            <div class="gallery-item"><img src="/img/shop-interior.jpg" alt="Shop interior"></div>
            <div class="gallery-item">shop photo</div>
            <div class="gallery-item">haircut photo</div>
            <div class="gallery-item">beard trim photo</div>
            <div class="gallery-item">chair / station photo</div>
            <div class="gallery-item">product shelf photo</div>
            <div class="gallery-item">waiting area photo</div>
            <div class="gallery-item">team photo</div>
            <div class="gallery-item">signage / storefront photo</div>
        </div>
    </div>
</section>

<section class="cta-banner">
    <div class="container">
        <h2>Come See Us In Person</h2>
        <a class="btn btn-dark" href="/BookNow">Book Now</a>
    </div>
</section>
